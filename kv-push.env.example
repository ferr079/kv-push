# kv-push — configuration
# Copy to /etc/kv-push/kv-push.env, chmod 600, then:
#   set -a; source /etc/kv-push/kv-push.env; set +a; ./kv-push.sh

# --- Cloudflare (required) ---------------------------------------------------
# Scoped API token with Workers KV Storage:Edit on the two namespaces.
# Do NOT use the Global API Key: it grants everything on the account and
# Cloudflare has been retiring it.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_STATUS_NAMESPACE_ID=
CF_STATS_NAMESPACE_ID=

# Keys written in each namespace (defaults shown)
#CF_STATUS_KEY=services
#CF_STATS_KEY=stats

# --- Service checks ----------------------------------------------------------
#SERVICES_FILE=/etc/kv-push/services.conf
#CHECK_TIMEOUT=5

# --- Proxmox (optional) ------------------------------------------------------
# One "name|host|api_token" per line. Token needs PVEAuditor (read-only).
# A node that is powered off is reported as offline instead of failing the run.
#PVE_NODES="pve1|10.0.0.11|monitor@pam!kvpush=00000000-0000-0000-0000-000000000000
#pve2|10.0.0.12|monitor@pam!kvpush=00000000-0000-0000-0000-000000000000"

# --- Forgejo / Gitea (optional) ----------------------------------------------
#FORGEJO_URL=https://forge.example.lab
#FORGEJO_TOKEN=
# Set to 0 only if the forge uses an internal CA this host does not trust.
#FORGEJO_TLS_VERIFY=1

# --- Hack The Box (optional) -------------------------------------------------
# flags = user_owns + system_owns; the /activity endpoint no longer exists.
#HTB_API_TOKEN=
#HTB_USER_ID=

# --- Root-Me (optional) ------------------------------------------------------
#ROOTME_UID=
#ROOTME_API_KEY=

# --- Semaphore (optional) ----------------------------------------------------
#SEMAPHORE_URL=https://semaphore.example.lab
#SEMAPHORE_TOKEN=
#SEMAPHORE_PROJECT_ID=1

# --- History endpoint (optional) ---------------------------------------------
# POSTed once per run so a Worker can snapshot the current state (e.g. into D1).
#HISTORY_URL=https://example.com/api/history/record
#HISTORY_KEY=
